{
  "name": "hamartia-desktop",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Nec0ti",
    "email": "nec0ti@users.noreply.github.com"
  },
  "homepage": "https://github.com/nec0ti/hamartia",
  "description": "Desktop shell for the local-first Hamartia study app",
  "main": "main.cjs",
  "scripts": {
    "build:ui": "npm --prefix ../frontend run build",
    "build:backend": "python ../backend/build_desktop.py",
    "test": "node --test",
    "bench:social-auth": "node benchmarks/benchmark_social_auth.cjs",
    "start": "npm run build:ui && electron .",
    "pack:dir": "npm run build:ui && npm run build:backend && electron-builder --dir",
    "dist:win": "npm run build:ui && npm run build:backend && electron-builder --win nsis",
    "dist:linux": "npm run build:ui && npm run build:backend && electron-builder --linux deb AppImage"
  },
  "build": {
    "appId": "io.github.nec0ti.hamartia",
    "productName": "Hamartia",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "chatgptIpc.cjs",
      "googleDesktopOAuth.cjs",
      "socialFirebase.cjs",
      "socialIpc.cjs",
      "socialConfig.cjs",
      "socialDocs.cjs",
      "preload.cjs",
      "chatgpt.cjs",
      "safeStorageSmoke.cjs",
      "backendInvocation.cjs",
      "restoreFlow.cjs",
      "shutdownFlow.cjs",
      "windowIcon.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/hamartia-backend",
        "to": "backend/hamartia-backend"
      },
      {
        "from": "../frontend/dist/social-public-config.json",
        "to": "social-public-config.json"
      },
      {
        "from": "build/icon.ico",
        "to": "icons/hamartia.ico"
      },
      {
        "from": "build/icons/512x512.png",
        "to": "icons/hamartia.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icons/512x512.png",
      "maintainer": "Necoti <nec0ti@users.noreply.github.com>",
      "category": "Education",
      "target": [
        "deb",
        "AppImage"
      ]
    }
  },
  "toolsets": {
    "appimage": "1.0.3"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "jose": "6.2.17"
  }
}
